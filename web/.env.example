# Salin file ini menjadi .env lalu isi API key Anda
# Provider: openrouter | gemini | openai | deepseek | ollama
AI_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys) â€” akses banyak model via satu key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Ollama (model lokal, tanpa API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---------- Pengaturan "otak" (opsional) ----------
# Kosongkan SYSTEM_PROMPT untuk memakai prompt bawaan di server.py
SYSTEM_PROMPT=

# Kreativitas jawaban: 0.0 (konsisten/akurat) sampai 1.0 (kreatif)
TEMPERATURE=0.4

# Panjang maksimum jawaban (token)
MAX_TOKENS=2048

# Pencarian web (DuckDuckGo, tanpa API key). Isi false untuk mematikan
WEB_SEARCH=true
SEARCH_RESULTS=5

# Penyedia pencarian (dicoba berurutan: Tavily, Brave, DuckDuckGo, Wikipedia)
TAVILY_API_KEY=
BRAVE_API_KEY=
WIKI_USER_AGENT=

# Batas riwayat yang dikirim ke model
MAX_HISTORY_MESSAGES=30
MAX_MESSAGE_CHARS=8000
MAX_CONTEXT_CHARS=24000

# ---------- Gateway API (auth, billing, cache) ----------
# TTL cache respons dalam detik (0 = matikan cache)
CACHE_TTL_SECONDS=120
# Harga estimasi per 1K token (USD) untuk metering biaya. 0 = tidak dihitung
PRICE_PER_1K_INPUT=0.0
PRICE_PER_1K_OUTPUT=0.0
# Wajibkan API key untuk endpoint /v1/* (1 = wajib, 0 = terbuka)
GATEWAY_REQUIRE_KEY=1

# ---------- Keamanan publik ----------
# Wajibkan API key (Bearer) untuk /api/chat & /api/export.
# Set true HANYA saat dipublikasikan agar kredit AI tidak disalahgunakan.
REQUIRE_API_KEY=false
# Origin yang diizinkan untuk CORS, dipisah koma (mis. https://webai.domain.com).
# Kosong = hanya same-origin (paling aman). Jangan pakai '*' bila credentials aktif.
ALLOWED_ORIGINS=
# Tampilkan detail internal di /health (provider, model, upstream).
# Biarkan false untuk publik.
HEALTH_DETAILS=false
# Rahasia untuk menandatangani token sesi/OAuth. WAJIB diset acak di publik.
# Buat dengan: python -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET=
