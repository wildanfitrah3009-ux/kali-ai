# Ganti example.com dengan domain Anda.
# Caddy akan otomatis menerbitkan sertifikat HTTPS (Let's Encrypt) bila domain
# sudah diarahkan ke server ini. Untuk lokal, gunakan: localhost

example.com {
    encode gzip

    # Streaming SSE butuh buffering dimatikan
    reverse_proxy app:8000 {
        flush_interval -1
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}
